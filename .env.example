# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# supabase/migrations/ 적용(npx supabase db push --db-url ...)과 npm run seed 전용 — 앱 런타임
# 스키마(src/lib/env.ts)의 검증 대상이 아니다. Project Settings → Database → Connect →
# Session pooler URI (direct connection 호스트는 IPv6 전용이라 IPv4망에서는 라우팅이 안 될 수 있다).
SUPABASE_DB_URL=

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Anthropic (Claude Vision — 악보 추출)
ANTHROPIC_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 로컬 개발 시 inngest-cli dev와 동기화하려면 1로 설정 (Inngest SDK가 직접 읽는 변수,
# src/lib/env.ts의 검증 대상이 아니며 프로덕션에서는 설정하지 않는다)
INNGEST_DEV=
